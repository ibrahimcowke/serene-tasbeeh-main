{
  "rewrites": [
    { "source": "/open", "destination": "/open.html" },
    { "source": "/((?!assets/|icons/|sw.js|favicon.ico|manifest.webmanifest).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
